# Copy this file to .env and fill in your own keys. Never commit .env.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_key_here
LLM_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=your_openrouter_key_here
NCBI_API_KEY=your_ncbi_key_here
NCBI_EMAIL=your_email_here
ANTHROPIC_API_KEY=your_anthropic_key_here
# Optional: bigger model for review and explanations (default openai/gpt-oss-120b)
LLM_MODEL_QUALITY=openai/gpt-oss-120b
# Optional: Bright Data, for src.etl.org_scrape. Without these, pages are fetched with a plain request.
BRIGHTDATA_API_KEY=your_brightdata_key_here
BRIGHTDATA_ZONE=your_web_unlocker_zone_name
BRIGHTDATA_SERP_ZONE=your_serp_zone_name
